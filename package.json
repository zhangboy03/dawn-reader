{
  "name": "dawn-reader",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "homepage": "https://dawn-reader-keeplearning.zhangboy.chatgpt.site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangboy03/dawn-reader.git"
  },
  "bugs": {
    "url": "https://github.com/zhangboy03/dawn-reader/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "sync:pdfjs": "node scripts/sync-pdfjs-assets.mjs",
    "predev": "npm run sync:pdfjs",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "npm run sync:pdfjs",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "epubjs": "^0.3.93",
    "hls.js": "^1.7.0",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@cloudflare/workers-types": "5.20260818.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "jsdom": "^30.0.1",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "7.0.2",
    "vinext": "1.0.0-beta.6",
    "vite": "8.2.1",
    "vitest": "^4.0.9",
    "wrangler": "4.123.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "@xmldom/xmldom": "^0.9.10",
    "image-size": "2.0.2"
  }
}
