# Optional. Dawn Reader works in offline-demo mode without either provider.

# Local, private AI. Start Ollama and make sure at least one model is installed.
# OLLAMA_MODEL=qwen3.5:4b-q4_K_M

# Recommended first trial: an OpenAI-compatible low-cost API.
# AI_PROVIDER=deepseek
# AI_BASE_URL=https://api.deepseek.com
# AI_API_KEY=
# AI_MODEL=deepseek-v4-flash
# Restart the dev server after changing these values, then use the
# "测试连接" button on the library screen. An explicit API provider takes
# priority over automatically detected Ollama models.

# The same four variables can point to Meta Model API or another
# OpenAI-compatible provider. Keep secrets only in .env; never in browser code.

# Low-latency A/B recipes (supply the matching provider key):
# Groq:     AI_PROVIDER=groq
#           AI_BASE_URL=https://api.groq.com/openai/v1
#           AI_MODEL=openai/gpt-oss-20b
# Cerebras: AI_PROVIDER=cerebras
#           AI_BASE_URL=https://api.cerebras.ai/v1
#           AI_MODEL=gpt-oss-120b

# Local A/B after explicitly downloading the model:
# AI_PROVIDER=ollama
# OLLAMA_MODEL=qwen3.5:9b-q4_K_M
